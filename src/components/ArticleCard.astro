---
import { getReadingTime } from '../data/posts.js';
const { post } = Astro.props;
const readingTime = getReadingTime(post);
---
<a class="article-card" href={'/article/' + post.slug + '/'}>
  <div style="position: relative;">
    <img src={post.image} alt={`${post.anime} – article cover image`} loading="lazy" style="width: 100%; height: 230px; object-fit: cover;" />
    {post.avatar && (
      <img src={post.avatar} alt="Character Avatar" style="position: absolute; bottom: -20px; right: 20px; width: 65px; height: 65px; border-radius: 50%; border: 4px solid white; box-shadow: 0 8px 20px rgba(0,0,0,0.15); object-fit: cover; background: white; z-index: 2;" />
    )}
  </div>
  <div class="card-body" style="padding-top: 1.5rem;">
    <span class="card-category">{post.category}</span>
    <h3>{post.title}</h3>
    <p>{post.excerpt}</p>
    <div class="card-meta">{readingTime} · {post.date}</div>
  </div>
</a>
