---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { characters } from '../../data/characters.js';
---
<BaseLayout title="Anime Characters — AnimeZenith" description="Explore detailed character profiles, backstories and analysis from your favorite anime.">
  <div class="char-container">
    <div class="container">
      <div class="char-header">
        <h1>Anime Characters</h1>
        <p>Explore full profiles, backstories, and analysis of your favorite characters from the biggest anime series.</p>
      </div>

      <div class="search-wrapper">
        <input type="text" id="char-search" class="search-box" placeholder="Search characters by name or anime..." />
      </div>

      <div class="char-grid" id="char-grid">
        {characters.map((char) => (
          <div class="char-card" data-name={char.name.toLowerCase()} data-anime={char.anime.toLowerCase()}>
            <div class="char-image-wrapper">
              <img src={char.image} alt={char.name + ' from ' + char.anime} loading="lazy" />
            </div>
            <div class="char-content">
              <span class="char-anime">{char.anime}</span>
              <h2 class="char-name">{char.name}</h2>
              <p class="char-role">Role: {char.role}</p>
              <p class="char-desc">{char.description}</p>
              <div class="char-traits">
                {char.traits.map((t) => (
                  <span class="trait">{t}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
      <div id="no-results" style="display: none; text-align: center; padding: 5rem; color: #777286; font-size: 1.2rem; font-weight: 600;">
        No characters found matching your search.
      </div>
    </div>
  </div>

  <style>
    .char-container {
      padding: 3rem 0 5rem 0;
      background: #ffffff;
    }
    .char-header {
      text-align: center;
      margin-bottom: 2.5rem;
    }
    .char-header h1 {
      font-size: 2.5rem;
      color: #211a32;
      margin-bottom: 1rem;
      letter-spacing: -1.5px;
      font-weight: 850;
    }
    .char-header p {
      font-size: 1.1rem;
      color: #777286;
      max-width: 700px;
      margin: 0 auto;
      line-height: 1.6;
    }
    .search-wrapper {
      max-width: 600px;
      margin: 0 auto 3rem auto;
    }
    .search-box {
      width: 100%;
      padding: 1rem 1.5rem;
      font-size: 1.1rem;
      border: 2px solid #eeeaf5;
      border-radius: 15px;
      outline: none;
      transition: all 0.3s ease;
      box-shadow: 0 10px 30px rgba(0,0,0,0.04);
      background: #faf9fc;
    }
    .search-box:focus {
      border-color: #7044dc;
      background: #ffffff;
      box-shadow: 0 10px 40px rgba(112, 68, 220, 0.15);
    }
    
    /* RESPONSIVE GRID: 2 on mobile, 3 on tablet, 4 on laptop */
    .char-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
    @media (min-width: 768px) {
      .char-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
      }
    }
    @media (min-width: 1024px) {
      .char-grid {
        grid-template-columns: repeat(4, 1fr);
        gap: 2rem;
      }
    }

    .char-card {
      background: #ffffff;
      border-radius: 16px;
      border: 1px solid #eeeaf5;
      overflow: hidden;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      display: flex;
      flex-direction: column;
      box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    }
    .char-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 30px rgba(112, 68, 220, 0.12);
      border-color: #d1c4f5;
    }
    
    /* PERFECT PORTRAIT IMAGES */
    .char-image-wrapper {
      width: 100%;
      aspect-ratio: 3 / 4;
      overflow: hidden;
      position: relative;
      background: #faf9fc;
    }
    .char-image-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
      transition: transform 0.5s ease;
    }
    .char-card:hover .char-image-wrapper img {
      transform: scale(1.05);
    }
    
    .char-content {
      padding: 1.2rem;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
    }
    .char-anime {
      color: #7044dc;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      font-size: 0.7rem;
      margin-bottom: 0.4rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .char-name {
      margin: 0 0 0.2rem 0;
      font-size: 1.3rem;
      color: #211a32;
      line-height: 1.2;
      font-weight: 850;
    }
    .char-role {
      color: #777286;
      font-size: 0.8rem;
      margin-bottom: 0.8rem;
      font-weight: 600;
    }
    .char-desc {
      color: #51495f;
      font-size: 0.85rem;
      line-height: 1.5;
      margin-bottom: 1rem;
      flex-grow: 1;
      display: -webkit-box;
      -webkit-line-clamp: 5;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .char-traits {
      display: flex;
      flex-wrap: wrap;
      gap: 0.3rem;
    }
    .trait {
      background: #f2edff;
      color: #4f2ca8;
      padding: 0.25rem 0.6rem;
      border-radius: 999px;
      font-size: 0.65rem;
      font-weight: 600;
    }
  </style>

  <script>
    const input = document.getElementById('char-search');
    const cards = document.querySelectorAll('.char-card');
    const noResults = document.getElementById('no-results');

    input.addEventListener('input', (e) => {
      const val = e.target.value.toLowerCase().trim();
      let visible = 0;
      cards.forEach((card) => {
        const name = card.getAttribute('data-name');
        const anime = card.getAttribute('data-anime');
        if (name.includes(val) || anime.includes(val)) {
          card.style.display = 'flex';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });
      noResults.style.display = visible === 0 ? 'block' : 'none';
    });
  </script>
</BaseLayout>
