---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { posts, getReadingTime } from '../../data/posts.js';
import { characters } from '../../data/characters.js';

export function getStaticPaths() {
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const moreArticles = posts
  .filter(item => item.slug !== post.slug)
  .sort((a, b) => Number(b.category === post.category) - Number(a.category === post.category))
  .slice(0, 3);
const relatedCharacters = characters.filter(character => character.anime === post.anime).slice(0, 6);
const readingTime = getReadingTime(post);
const absoluteImage = new URL(post.image, Astro.site).href;
const canonical = new URL(`/article/${post.slug}/`, Astro.site).href;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  image: [absoluteImage],
  datePublished: post.date,
  dateModified: post.modifiedDate || post.date,
  author: { '@type': 'Organization', name: post.author },
  publisher: {
    '@type': 'Organization',
    name: 'AnimeZenith',
    logo: { '@type': 'ImageObject', url: new URL('/logo.png', Astro.site).href }
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  inLanguage: 'en'
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: post.category, item: new URL('/category/' + post.category.toLowerCase() + '/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: post.title, item: canonical }
  ]
};
---
<BaseLayout title={post.title + ' | AnimeZenith'} description={post.excerpt} image={post.image} type="article">
  <article class="container article-layout">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href={'/category/' + post.category.toLowerCase() + '/'}>{post.category}</a> / <span>{post.title}</span>
    </nav>

    <span class="eyebrow">{post.category}</span>
    <h1>{post.title}</h1>
    <p class="article-meta">By {post.author} · <time datetime={post.date}>{post.date}</time> · {readingTime}</p>

    {post.spoilerLevel && (
      <aside class="article-spoiler" aria-label="Spoiler information">
        <strong>{post.spoilerLevel}</strong>
        <span>Read the section headings before continuing if you want to avoid story details.</span>
      </aside>
    )}

    <img class="article-cover" src={post.image} alt={`${post.anime} – article cover image`} fetchpriority="high" decoding="async" />

    <div class="article-content">
      {post.sections.map((section, index) => (
        <section class="article-section">
          <h2>{section.heading}</h2>
          {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
          {post.comparison && section.heading === 'Quick comparison' && (
            <div class="article-table-wrap">
              <table class="article-comparison">
                <thead><tr><th scope="col">Style</th><th scope="col">Associated user(s)</th><th scope="col">General identity</th></tr></thead>
                <tbody>
                  {post.comparison.map(row => <tr><th scope="row">{row.style}</th><td>{row.user}</td><td>{row.identity}</td></tr>)}
                </tbody>
              </table>
            </div>
          )}
        </section>
      ))}
    </div>

    <div class="article-tags">
      <strong>Topics:</strong> {post.tags.join(', ')}
    </div>

    {post.sources?.length > 0 && (
      <section class="article-sources" aria-labelledby="article-sources-heading">
        <h2 id="article-sources-heading">Sources & further reading</h2>
        <p>Official series pages used to check basic story, staff and character information. Interpretive opinions in this article are AnimeZenith’s editorial analysis.</p>
        <ul>
          {post.sources.map(source => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a></li>)}
        </ul>
      </section>
    )}

    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </article>

  {relatedCharacters.length > 0 && (
    <section class="container section related-character-section">
      <div class="section-heading">
        <div><h2>Characters in {post.anime}</h2><p>Explore character profiles connected to this series.</p></div>
        <a class="text-link" href="/characters/">View all →</a>
      </div>
      <div class="related-character-grid">
        {relatedCharacters.map(character => (
          <a class="related-character-card" href={'/character/' + character.id + '/'}>
            <img src={character.image} alt={character.name} loading="lazy" decoding="async" />
            <span><strong>{character.name}</strong><small>{character.role}</small></span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="container section">
    <div class="section-heading"><h2>Related articles</h2><a class="text-link" href="/search/">Explore all →</a></div>
    <div class="article-grid">{moreArticles.map(item => <ArticleCard post={item} />)}</div>
  </section>
</BaseLayout>

<style>
  .article-spoiler { display:flex; flex-direction:column; gap:.25rem; margin:1.25rem 0; padding:1rem 1.15rem; border:1px solid #eadcfb; border-left:4px solid #7044dc; border-radius:12px; background:#faf7ff; color:#46365f; }
  .article-spoiler span,.article-sources p { color:#716b7d; font-size:.94rem; }
  .article-section { margin:2rem 0; }
  .article-section h2 { margin:0 0 .85rem; color:#211a32; font-size:clamp(1.35rem,2.5vw,1.8rem); line-height:1.3; }
  .article-content p { line-height:1.85; }
  .article-tags { margin:2rem 0; padding:1rem 0; border-top:1px solid #eeeaf5; border-bottom:1px solid #eeeaf5; color:#625b70; }
  .article-sources { margin:2rem 0; padding:1.25rem; border:1px solid #eeeaf5; border-radius:14px; background:#fcfbfe; }
  .article-sources h2 { margin:0 0 .5rem; font-size:1.25rem; color:#211a32; }
  .article-sources ul { margin:.75rem 0 0; padding-left:1.25rem; }
  .article-sources li { margin:.5rem 0; line-height:1.6; }
  .article-sources a { color:#7044dc; text-decoration:underline; text-underline-offset:3px; }
  .article-table-wrap { overflow-x:auto; margin:1.25rem 0; }
  .article-comparison { width:100%; min-width:620px; border-collapse:collapse; font-size:.95rem; }
  .article-comparison th,.article-comparison td { padding:.8rem; border:1px solid #e9e4f1; text-align:left; vertical-align:top; }
  .article-comparison thead { background:#f5f1fc; color:#302448; }
  .article-comparison tbody th { color:#302448; background:#fcfbfe; }
  .related-character-section { border-radius:20px; padding:2rem; background:#faf9fc; }
  .related-character-grid { display:flex; flex-wrap:wrap; gap:1rem; }
  .related-character-card { display:flex; align-items:center; gap:.85rem; min-width:220px; padding:.85rem; border:1px solid #eeeaf5; border-radius:12px; background:#fff; color:inherit; text-decoration:none; }
  .related-character-card img { width:54px; height:54px; border-radius:50%; object-fit:cover; }
  .related-character-card span { display:flex; flex-direction:column; gap:.2rem; }
  .related-character-card small { color:#777286; }
  @media (max-width:600px) { .related-character-section { padding:1.25rem; } .related-character-card { min-width:100%; } }
</style>
