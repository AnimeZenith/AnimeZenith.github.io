---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const {
  title = 'AnimeZenith — Anime News, Reviews, Guides & Manga',
  description = 'Explore anime news, reviews, guides, manga and character features on AnimeZenith.',
  image = '/logo.png',
  type = 'website'
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.href : 'https://animezenith.github.io/';
const canonical = new URL(Astro.url.pathname, siteUrl).href;

// Makes sure Open Graph image is always an absolute URL (Fix for WhatsApp/Twitter sharing)
const absoluteImage = new URL(image, siteUrl).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'AnimeZenith',
  url: siteUrl,
  logo: new URL('/logo.png', siteUrl).href,
  description: 'Anime news, reviews, guides and manga editorial website.'
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="google-site-verification" content="fvETlqKu6xDLduAkCk9jmbyK3OHlKOs_M8IhwHnMnME" />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content={description} />
  <meta name="robots" content="index,follow,max-image-preview:large" />
  <link rel="canonical" href={canonical} />
  
  <!-- Favicon & Logo -->
  <link rel="icon" type="image/png" href="/logo.png" />
  <link rel="apple-touch-icon" href="/logo.png" />
  
  <link rel="preload" as="image" href="/images/frieren-cover.jpg" fetchpriority="high" />
  <link rel="alternate" type="application/rss+xml" title="AnimeZenith RSS" href="/rss.xml" />
  
  <!-- Open Graph Metadata (For WhatsApp, Facebook, Discord) -->
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="AnimeZenith" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={absoluteImage} />
  <meta property="og:image:alt" content={title} />
  
  <!-- Twitter Card Metadata -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={absoluteImage} />
  
  <meta name="theme-color" content="#7044dc" />
  <title>{title}</title>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</head>
<body>
  <Header />
  <main><slot /></main>
  <Footer />
</body>
</html>
